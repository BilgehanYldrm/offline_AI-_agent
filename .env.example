# Optional public frontend setting. NEVER put secrets in VITE_* variables.
# Default /api uses the Vite development proxy. For a separate local backend:
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend settings are operating-system environment variables (not loaded from this file).
# SEMANTIC_MODEL_PATH=/absolute/path/to/a/pre-downloaded/model
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
